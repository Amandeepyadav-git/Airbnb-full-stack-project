<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <div class="col-8 offset-3">
    <h3><%= listing.title %></h3>
        </div>
    <div class="card col-6 offset-3 show-card">
       <img src="<%=  listing.image.url  %>" class="card-img-top show-img" alt="listing_image">
  <div class="card-body">
    <p class="card-text">
      <br>
      <%= listing.description %> <br>
       &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
       <%= listing.location %> <br>
       <%= listing.country %>
    </p>
  </div>
    </div>
    <br>
</div>
   <div class="btns"><a href="/listing/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
 <form action="/listing/<%= listing._id %>?_method=DELETE" method="POST">
    <button onclick="return confirm(`Do you want to delte this listing?`)" class="btn btn-dark offset-5">Delete</button>
   </form>
  <div class="col-8 offset-3">
    <h4>Leave a review</h4>
    <form action="">
      <div>
        <label for="rating">Rating</label>
        <input type="ranger" min="1" max="5">
      </div>
    </form>
  </div>
  </div>